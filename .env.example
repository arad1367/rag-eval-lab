# Copy this file to .env and fill in your own key:  cp .env.example .env
# .env is in .gitignore, so your key never goes to GitHub.

# Option A (default): Groq free tier - get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-groq-key-here
LLM_MODEL=openai/gpt-oss-20b

# Option B: Ollama running locally (no key needed). Uncomment these 3 lines instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Retrieval settings used by the API (pick the winners of your experiment)
RETRIEVER=hybrid
CHUNK_SIZE=300